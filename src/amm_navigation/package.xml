<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>amm_navigation</name>
  <version>0.0.0</version>

  <description>
    Navegacion autonoma del MiR100 mediante Nav2.
    Incluye planificacion, control de trayectorias,
    gestion de objetivos y estaciones de trabajo.
  </description>

  <maintainer email="carlo@todo.todo">carlo</maintainer>
  <license>Apache-2.0</license>

  <!-- Herramientas de comprobacion -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- Comunicacion y mensajes ROS 2 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>

  <!-- Servicios de ejecucion y cancelacion -->
  <exec_depend>std_srvs</exec_depend>

  <!-- Lectura de archivos YAML -->
  <exec_depend>python3-yaml</exec_depend>

  <!-- Transformaciones TF2 -->
  <exec_depend>tf2_ros</exec_depend>

  <!-- Infraestructura de lanzamiento -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- Servidores principales de Nav2 -->
  <exec_depend>nav2_planner</exec_depend>
  <exec_depend>nav2_controller</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_behaviors</exec_depend>
  <exec_depend>nav2_bt_navigator</exec_depend>

  <!--
    Planificador global NavFn.
    Utilizado para calcular trayectorias sobre
    el mapa y el global costmap.
  -->
  <exec_depend>nav2_navfn_planner</exec_depend>

  <!--
    Controlador Regulated Pure Pursuit.
    Utilizado para seguir trayectorias y generar
    comandos de velocidad para el MiR100.
  -->
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>

  <!-- Visualizacion de mapas, costmaps y trayectorias -->
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>