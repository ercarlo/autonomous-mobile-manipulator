<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amm_description</name>
  <version>0.0.0</version>
  <description>Robot description for the Autonomous Mobile Manipulator</description>
  <maintainer email="carlo@todo.todo">carlo</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

    <!-- Modelos externos que componen el robot -->
  <exec_depend>mir_description</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <!-- Modelo industrial de la pinza Robotiq 2F-85 -->
  <exec_depend>robotiq_description</exec_depend>

  <!-- Procesamiento de los archivos Xacro -->
  <exec_depend>xacro</exec_depend>

  <!-- Publicación de transformaciones y estados -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>

  <!-- Visualización del robot -->
  <exec_depend>rviz2</exec_depend>

  <!-- Interfaces de control desarrolladas para el robot -->
  <exec_depend>amm_control</exec_depend>

  <!-- Herramientas utilizadas por el archivo launch -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>


</package>
