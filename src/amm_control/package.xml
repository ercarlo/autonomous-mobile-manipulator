<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>amm_control</name>
  <version>0.0.0</version>

  <description>
    Configuracion de ros2_control y lanzamiento del
    Autonomous Mobile Manipulator en Gazebo Harmonic.
  </description>

  <maintainer email="carlo@todo.todo">carlo</maintainer>
  <license>Apache-2.0</license>

  <!-- Sistema de compilacion -->
  <buildtool_depend>ament_cmake</buildtool_depend>



  <!-- Generacion y publicacion de la descripcion del robot -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- Infraestructura de lanzamiento ROS 2 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- Insercion del robot en Gazebo Harmonic -->
  <exec_depend>ros_gz_sim</exec_depend>

  <!-- Integracion entre Gazebo y ros2_control -->
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>

  <!-- Publicacion de estados articulares -->
  <exec_depend>joint_state_broadcaster</exec_depend>

  <!-- Control de trayectorias del manipulador UR5e -->
  <exec_depend>joint_trajectory_controller</exec_depend>

  <!-- Control de apertura y cierre de la pinza Robotiq -->
  <exec_depend>parallel_gripper_controller</exec_depend>

  <!-- Herramientas de comprobacion del paquete -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>