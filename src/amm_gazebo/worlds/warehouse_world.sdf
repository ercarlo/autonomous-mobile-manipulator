<?xml version="1.0"?>

<!--
  ============================================================
  AUTONOMOUS MOBILE MANIPULATOR - WAREHOUSE WORLD
  ============================================================

  Paquete: amm_gazebo
  Archivo: warehouse_world.sdf

  Objetivo:
    Crear un almacén sencillo para desarrollar y validar
    SLAM Toolbox, AMCL y posteriormente Nav2.

  Dimensiones:
    - Suelo de 12.4 x 12.4 metros.
    - Recinto delimitado por cuatro paredes.
    - Cuatro estanterías representadas por bloques sólidos.
    - Dos estaciones señalizadas visualmente.

  El robot se insertará posteriormente desde amm_control.

  IMPORTANTE:
    Conservamos Ogre como motor de sensores.
    En VMware utilizaremos LIBGL_ALWAYS_SOFTWARE=1
    para evitar errores de medición del lidar.
  ============================================================
-->

<sdf version="1.9">

  <world name="amm_warehouse_world">

    <!-- ====================================================
         1. FÍSICA
         ==================================================== -->

    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.81</gravity>

    <!-- ====================================================
         2. SISTEMAS DE GAZEBO
         ====================================================

         Reutilizamos los mismos plugins que ya hemos
         validado en test_world.sdf.
    -->

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- ====================================================
         3. ILUMINACIÓN
         ==================================================== -->

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>

      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <direction>-0.3 -0.4 -1</direction>
    </light>

    <!-- ====================================================
         4. SUELO
         ====================================================

         Suelo ligeramente mayor que el recinto para
         garantizar que las paredes quedan apoyadas.

         Superficie superior situada en Z = 0.
    -->

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>

      <link name="ground_link">

        <collision name="ground_collision">
          <geometry>
            <box>
              <size>12.4 12.4 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <box>
              <size>12.4 12.4 0.1</size>
            </box>
          </geometry>

          <material>
            <ambient>0.65 0.67 0.7 1</ambient>
            <diffuse>0.65 0.67 0.7 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- ====================================================
         5. PAREDES EXTERIORES
         ====================================================

         Altura: 2.5 m
         Grosor: 0.2 m

         El lidar podrá detectar las paredes incluso
         cuando no haya obstáculos interiores.

         Las cuatro paredes forman un recinto cerrado.
    -->

    <!-- Pared norte: Y positivo -->

    <model name="north_wall">
      <static>true</static>
      <pose>0 5.9 1.25 0 0 0</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box><size>12 0.2 2.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>12 0.2 2.5</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Pared sur: Y negativo -->

    <model name="south_wall">
      <static>true</static>
      <pose>0 -5.9 1.25 0 0 0</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box><size>12 0.2 2.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>12 0.2 2.5</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Pared este: X positivo -->

    <model name="east_wall">
      <static>true</static>
      <pose>5.9 0 1.25 0 0 0</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 11.6 2.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>0.2 11.6 2.5</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Pared oeste: X negativo -->

    <model name="west_wall">
      <static>true</static>
      <pose>-5.9 0 1.25 0 0 0</pose>

      <link name="wall_link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 11.6 2.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>0.2 11.6 2.5</size></box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- ====================================================
         6. ESTANTERÍAS
         ====================================================

         Representamos cuatro estanterías mediante bloques.

         Dimensiones de cada una:
           X = 0.75 m
           Y = 2.2 m
           Z = 1.5 m

         Sus centros se distribuyen simétricamente.

         Se dejan pasillos amplios para el MiR100.
         Las colisiones coinciden con las geometrías
         visuales para que el lidar y el control de
         movimiento tengan obstáculos consistentes.
    -->

    <model name="shelf_1">
      <static>true</static>
      <pose>-2.8 2.4 0.75 0 0 0</pose>

      <link name="shelf_link">
        <collision name="collision">
          <geometry>
            <box><size>0.75 2.2 1.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>0.75 2.2 1.5</size></box>
          </geometry>
          <material>
            <diffuse>0.4 0.5 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="shelf_2">
      <static>true</static>
      <pose>2.8 2.4 0.75 0 0 0</pose>

      <link name="shelf_link">
        <collision name="collision">
          <geometry>
            <box><size>0.75 2.2 1.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>0.75 2.2 1.5</size></box>
          </geometry>
          <material>
            <diffuse>0.4 0.5 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="shelf_3">
      <static>true</static>
      <pose>-2.8 -2.4 0.75 0 0 0</pose>

      <link name="shelf_link">
        <collision name="collision">
          <geometry>
            <box><size>0.75 2.2 1.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>0.75 2.2 1.5</size></box>
          </geometry>
          <material>
            <diffuse>0.4 0.5 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="shelf_4">
      <static>true</static>
      <pose>2.8 -2.4 0.75 0 0 0</pose>

      <link name="shelf_link">
        <collision name="collision">
          <geometry>
            <box><size>0.75 2.2 1.5</size></box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box><size>0.75 2.2 1.5</size></box>
          </geometry>
          <material>
            <diffuse>0.4 0.5 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====================================================
         7. ESTACIONES DE RECOGIDA Y ENTREGA
         ====================================================

         Estas plataformas solamente tienen geometría
         visual: no tienen colisión.

         Así podremos identificar las estaciones sin
         crear desniveles ni obstáculos en el suelo.

         Posteriormente colocaremos mesas, contenedores
         y objetos manipulables en estas zonas.
    -->

    <!-- Estación A: recogida -->

    <model name="pickup_station">
      <static>true</static>
      <pose>-3.8 0 0.005 0 0 0</pose>

      <link name="station_link">
        <visual name="visual">
          <geometry>
            <box><size>0.9 0.9 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.45 0.9 1</ambient>
            <diffuse>0.1 0.45 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Estación B: entrega -->

    <model name="delivery_station">
      <static>true</static>
      <pose>3.8 0 0.005 0 0 0</pose>

      <link name="station_link">
        <visual name="visual">
          <geometry>
            <box><size>0.9 0.9 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.75 0.3 1</ambient>
            <diffuse>0.1 0.75 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>